<ul class="house-existing-list">
  <% households.each do |household| %>
    <li class="house-existing-item">
      <%= link_to household_dashboard_path(household),
                  class: "house-existing-card-link" do %>

        <span class="house-existing-name">
          <%= household.name %>
        </span>

        <span class="house-existing-meta">
          <%= pluralize(household.household_memberships.size, "member") %>
        </span>

      <% end %>
    </li>
  <% end %>
</ul>
