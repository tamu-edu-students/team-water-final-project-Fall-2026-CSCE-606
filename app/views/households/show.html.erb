
<h1><%= @household.name %></h1>

<p><%= link_to "Open household dashboard", household_dashboard_path(@household) %></p>

<p>
  Created by: <%= @household.creator.name %>
</p>

<h2>Household Members</h2>

<ul>
  <% @household.household_memberships.includes(:user).each do |membership| %>
    <li>
      <%= membership.user.name %>

      <% if @household.admin?(current_user) &&
            membership.user_id != current_user.id &&
            membership.role != "admin" %>

        <%= button_to "Remove Roommate",
      household_household_membership_path(@household, membership),
      method: :delete,
      form: {
        data: {
          turbo_confirm: "Remove this roommate? The invitation code will also be revoked."
        }
      } %>
      <% end %>
    </li>
  <% end %>
</ul>
<% my_membership = @household.household_memberships.find_by(user: current_user) %>

<% remaining = @household.household_memberships
                         .includes(:user)
                         .where.not(user_id: current_user.id) %>

<% needs_successor = my_membership.role == "admin" &&
                     !remaining.exists?(role: "admin") %>

<section>
  <h2>Leave Household</h2>

  <% if remaining.exists? %>
    <%= form_with url: leave_household_path(@household),
                  method: :delete, local: true do %>

      <% if needs_successor %>
        <p>
          You are the household admin.
          Please choose a new admin before leaving.
        </p>

        <%= label_tag :successor_user_id, "Choose Next Admin" %>

        <%= select_tag :successor_user_id,
              options_from_collection_for_select(
                remaining.map(&:user), :id, :name
              ),
              prompt: "Select a roommate",
              required: true %>
      <% end %>

      <%= submit_tag "Leave Household",
            data: {
              turbo_confirm: "Are you sure you want to leave this household?"
            } %>

    <% end %>
  <% else %>
    <p>You cannot leave because you are the last household member.</p>
  <% end %>
</section>
<section>
  <h2>Invite Roommates</h2>

  <% if @household.admin?(current_user) %>
    <p>Current invitation code:</p>

    <p>
      <strong><%= @household.invite_code %></strong>
    </p>

    <%= button_to "Revoke and Generate New Code",
          regenerate_invite_code_household_path(@household),
          method: :patch,
          data: {
            turbo_confirm: "The old invitation code will stop working. Continue?"
          } %>

    <p>
      Regenerating the code will invalidate the previous code.
      Existing household members will not be affected.
    </p>
  <% else %>
    <p>Contact your household admin for an invitation.</p>
  <% end %>
</section>

<section>
  <h2>Household Expenses</h2>
  
  <% if @balance %>
    <div class="balance-summary">
      <p>
        <strong>Your Balance:</strong>
        <% if @balance[:net_balance] > 0 %>
          You are owed $<%= number_with_precision(@balance[:net_balance], precision: 2) %>
        <% elsif @balance[:net_balance] < 0 %>
          You owe $<%= number_with_precision(@balance[:net_balance].abs, precision: 2) %>
        <% else %>
          All settled up
        <% end %>
      </p>

      <ul class="balance-details">
        <li>
          Owed to you:
          <strong>$<%= number_with_precision(@balance[:total_owed_to_me], precision: 2) %></strong>
        </li>
        <li>
          You owe:
          <strong>$<%= number_with_precision(@balance[:total_i_owe], precision: 2) %></strong>
        </li>
      </ul>
    </div>
  <% end %>

  <p>
    <%= link_to "Add New Expense", new_household_expense_path(@household) %>
  </p>

  <h3>Recent Expenses</h3>
  
  <% if @expenses && @expenses.any? %>
    <ul>
      <% @expenses.each do |expense| %>
        <li>
          <strong><%= link_to expense.title, household_expense_path(@household, expense) %></strong> -
          $<%= number_with_precision(expense.amount, precision: 2) %> - 
          Paid by <%= expense.created_by.name %> on <%= expense.expense_date.strftime("%m/%d/%Y") %>
          
          <% if expense.due_date %>
            · Due <%= expense.due_date.strftime("%m/%d/%Y") %>
          <% end %>

          <% participant = expense.expense_participants.find_by(user: current_user) %>
          <% if participant %>
            <br>
            Your portion: $<%= number_with_precision(participant.amount_owed, precision: 2) %>
            <% if participant.payment_status == 'paid' %>
              (Paid)
            <% else %>
              (Pending)
              <%= form_with url: mark_paid_household_expense_path(@household, expense), method: :patch, local: true do |f| %>
                <%= hidden_field_tag :participant_id, participant.id %>
                <%= f.submit "Mark as Paid" %>
              <% end %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No expenses yet.</p>
  <% end %>
</section>

<section>
  <h2>Household Rules &amp; Agreements</h2>
  <p><%= link_to "View Household Rules & Proposals", household_rules_path(@household) %></p>
</section>

<p>
  <%= link_to "Back to My Households", households_path %>
</p>
