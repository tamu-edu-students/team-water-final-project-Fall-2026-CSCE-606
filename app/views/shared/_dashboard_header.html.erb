<a class="dashboard-skip" href="#dashboard-main">Skip to main content</a>

<!-- PERSISTENT COLLAPSIBLE SIDEBAR DOCK -->
<aside class="dashboard-sidebar is-minimized" id="dashboard-sidebar" aria-label="Sidebar navigation">
  <div class="dashboard-sidebar-top">
    <%= link_to root_path, class: "dashboard-brand", title: "Roommate OS Home" do %>
      <span class="dashboard-brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
      </span>
      <span class="dashboard-brand-text">Roommate OS</span>
    <% end %>
    <button type="button" class="dashboard-sidebar-toggle-btn" id="sidebar-collapse-btn" aria-label="Toggle sidebar" title="Toggle sidebar">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>

  <ul class="dashboard-sidebar-nav">
    <% if defined?(@household) && @household.present? && @household.persisted? %>
      <li>
        <%= link_to household_dashboard_path(@household),
                    class: "dashboard-sidebar-link #{'is-active' if controller_name == 'dashboards'}",
                    data: { tooltip: "Dashboard" } do %>
          <svg class="dashboard-sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7" rx="1"/>
            <rect x="14" y="3" width="7" height="7" rx="1"/>
            <rect x="14" y="14" width="7" height="7" rx="1"/>
            <rect x="3" y="14" width="7" height="7" rx="1"/>
          </svg>
          <span>Dashboard</span>
        <% end %>
      </li>
      <li>
        <%= link_to household_chores_path(@household),
                    class: "dashboard-sidebar-link #{'is-active' if controller_name == 'chores'}",
                    data: { tooltip: "Chores" } do %>
          <svg class="dashboard-sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 11l3 3L22 4"/>
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
          </svg>
          <span>Chores</span>
        <% end %>
      </li>
      <li>
        <%= link_to household_expenses_path(@household),
                    class: "dashboard-sidebar-link #{'is-active' if controller_name == 'expenses'}",
                    data: { tooltip: "Split Expenses" } do %>
          <svg class="dashboard-sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="9"/>
            <path d="M14.8 9A2 2 0 0 0 13 8h-2a2 2 0 0 0 0 4h2a2 2 0 0 1 0 4h-2a2 2 0 0 1-1.8-1"/>
            <path d="M12 6v2m0 8v2"/>
          </svg>
          <span>Split Expenses</span>
        <% end %>
      </li>
      <li>
        <%= link_to household_rules_path(@household),
                    class: "dashboard-sidebar-link #{'is-active' if controller_name == 'rules'}",
                    data: { tooltip: "House Rules & Voting" } do %>
          <svg class="dashboard-sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
          </svg>
          <span>House Rules</span>
        <% end %>
      </li>
    <% else %>
      <li>
        <%= link_to root_path, class: "dashboard-sidebar-link is-active", data: { tooltip: "Home" } do %>
          <svg class="dashboard-sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          </svg>
          <span>Home</span>
        <% end %>
      </li>
    <% end %>

    <li>
      <%= link_to calendar_path,
                  class: "dashboard-sidebar-link #{'is-active' if action_name == 'calendar'}",
                  data: { tooltip: "Calendar" } do %>
        <svg class="dashboard-sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        <span>Calendar</span>
      <% end %>
    </li>
    <li>
      <%= link_to households_path,
                  class: "dashboard-sidebar-link #{'is-active' if controller_name == 'households' && action_name == 'index'}",
                  data: { tooltip: "My Households" } do %>
        <svg class="dashboard-sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        <span>My Households</span>
      <% end %>
    </li>

    <% if defined?(@household) && @household.present? && @household.persisted? %>
      <li>
        <%= link_to household_path(@household),
                    class: "dashboard-sidebar-link #{'is-active' if controller_name == 'households' && action_name == 'show'}",
                    data: { tooltip: "Household Details" } do %>
          <svg class="dashboard-sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
          <span>Household Details</span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <div class="dashboard-sidebar-footer">
    <%= button_to "Log Out", logout_path, method: :delete, class: "dashboard-button dashboard-button-secondary", style: "width: 100%;" %>
  </div>
</aside>
<div class="dashboard-sidebar-backdrop" id="dashboard-sidebar-backdrop"></div>

<!-- UNIVERSAL TOPBAR HEADER -->
<header class="dashboard-header">
  <div class="dashboard-header-brand-wrap">
    <button type="button" class="dashboard-menu-toggle-btn" id="header-menu-toggle" aria-label="Toggle navigation menu" title="Toggle navigation menu">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <span>Menu</span>
    </button>

    <%= link_to root_path, class: "dashboard-brand" do %>
      <span class="dashboard-brand-mark" aria-hidden="true">R</span>
      Roommate OS
    <% end %>

    <% if defined?(@household) && @household.present? && @household.persisted? %>
      <details class="dashboard-household-dropdown" id="household-dropdown">
        <summary class="dashboard-household-pill" aria-label="Switch household" role="button" title="Switch household">
          <span><%= @household.name %></span>
          <svg class="dashboard-dropdown-chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="dashboard-dropdown-menu">
          <div class="dashboard-dropdown-header">Switch Household</div>
          <% (current_user&.households&.order(:name, :id) || [@household]).each do |h| %>
            <%= link_to household_dashboard_path(h), class: "dashboard-dropdown-item #{'is-current' if h.id == @household.id}" do %>
              <span class="dashboard-dropdown-item-name"><%= h.name %></span>
              <% if h.id == @household.id %>
                <svg class="dashboard-dropdown-check" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <% end %>
            <% end %>
          <% end %>
          <div class="dashboard-dropdown-divider"></div>
          <%= link_to household_path(@household), class: "dashboard-dropdown-item dashboard-dropdown-item--secondary" do %>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            <span>Household details &amp; invitations</span>
          <% end %>
          <%= link_to new_household_path, class: "dashboard-dropdown-item dashboard-dropdown-item--secondary" do %>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>Create a new household</span>
          <% end %>
        </div>
      </details>
    <% end %>
  </div>

  <nav class="dashboard-nav" aria-label="Main navigation">
    <% if defined?(@household) && @household.present? && @household.persisted? %>
      <div class="dashboard-quick-tabs">
        <%= link_to "Dashboard", household_dashboard_path(@household), class: "dashboard-tab-link #{'is-active' if controller_name == 'dashboards'}" %>
        <%= link_to "Chores", household_chores_path(@household), class: "dashboard-tab-link #{'is-active' if controller_name == 'chores'}" %>
        <%= link_to "Expenses", household_expenses_path(@household), class: "dashboard-tab-link #{'is-active' if controller_name == 'expenses'}" %>
        <%= link_to "Rules", household_rules_path(@household), class: "dashboard-tab-link #{'is-active' if controller_name == 'rules'}" %>
      </div>
    <% end %>

    <%= link_to calendar_path, class: "dashboard-calendar-icon-link",
                aria: { label: "Open calendar" },
                title: "Open calendar" do %>
      <svg class="dashboard-nav-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none">
        <rect x="3.5" y="5" width="17" height="15.5" rx="2" stroke="currentColor" stroke-width="1.8"/>
        <path d="M7.5 3.5v3M16.5 3.5v3M3.5 9.5h17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        <path d="M8 13h2m4 0h2m-8 3h2m4 0h2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    <% end %>
    <%= link_to "My Households", households_path %>
    <%= button_to "Log Out", logout_path, method: :delete, class: "dashboard-button dashboard-button-secondary" %>
  </nav>
</header>
