<% content_for :title, "Join Household | Roommate OS" %>

<div class="household-onboarding">
  <header class="house-topbar">
    <%= link_to root_path, class: "house-logo" do %>
      <span class="house-logo-mark" aria-hidden="true">⌂</span>
      <span>Roommate OS</span>
    <% end %>
  </header>

  <main class="house-main">
    <div class="house-welcome">
      <h1><span>Join Your Roommates</span>Move into your shared space.</h1>
      <p>Enter the invitation code shared by your household admin.</p>
    </div>

    <section class="house-card house-single-card"
             aria-labelledby="join-household-title">
      <h2 id="join-household-title">♧ Join an Existing Household</h2>
      <p>
        Already have a roommate using Roommate OS?
        Enter their invitation code below.
      </p>

      <% if flash[:alert] %>
        <div class="house-error" role="alert">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= form_with url: join_household_path, method: :post do |form| %>
        <div class="house-field">
          <%= form.label :invite_code, "Invitation Code" %>
          <%= form.text_field :invite_code,
                placeholder: "Paste your invitation code",
                autocomplete: "off",
                autocapitalize: "off",
                spellcheck: false,
                required: true %>
        </div>

        <%= form.submit "Join Household",
                        class: "house-primary" %>
      <% end %>
    </section>

    <%= link_to "← Back to My Households",
                root_path,
                class: "house-back" %>
  </main>
</div>
