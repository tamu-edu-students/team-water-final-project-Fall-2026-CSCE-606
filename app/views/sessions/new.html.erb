
<% content_for :title, "Log In | Roommate OS" %>

<main class="auth-page">
  <section class="auth-card" aria-labelledby="login-heading">

    <div class="auth-brand">
      <span class="auth-brand-icon" aria-hidden="true">⌂</span>
      <span>Roommate OS</span>
    </div>

    <div class="auth-heading">
      <h1 id="login-heading">Welcome back!</h1>
      <p>Log in to keep your shared home running smoothly.</p>
    </div>

    <% if flash[:alert] %>
      <div class="auth-errors" role="alert">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: login_path, scope: nil do |form| %>

      <div class="auth-field">
        <%= form.label :email, "Email address" %>
        <%= form.email_field :email,
              placeholder: "you@example.com",
              autocomplete: "email",
              required: true %>
      </div>

      <div class="auth-field">
        <%= form.label :password %>
        <%= form.password_field :password,
              placeholder: "Enter your password",
              autocomplete: "current-password",
              required: true %>
      </div>

      <%= form.submit "Log In", class: "auth-submit" %>

    <% end %>

    <p class="auth-footer">
      New to Roommate OS?
      <%= link_to "Create an account", signup_path %>
    </p>

  </section>
</main>

