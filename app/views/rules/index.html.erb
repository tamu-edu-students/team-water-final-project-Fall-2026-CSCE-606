<% content_for :title, "#{@household.name} House Hub | Roommate OS" %>

<div class="dashboard-shell">
  <%= render "shared/dashboard_header" %>

  <main id="dashboard-main" class="dashboard-main">
    <nav class="dashboard-breadcrumb" aria-label="Breadcrumb">
      <%= link_to "Your households", root_path %>
      <span aria-hidden="true">/</span>
      <%= link_to @household.name, household_dashboard_path(@household) %>
      <span aria-hidden="true">/</span>
      <span aria-current="page">House Hub</span>
    </nav>

    <div class="dashboard-heading">
      <div>
        <p class="dashboard-eyebrow">Household central hub</p>
        <h1><%= @household.name %> House Hub</h1>
        <p class="dashboard-subtitle">Household vault, shared agreements, and property details.</p>
      </div>
      <div class="dashboard-actions">
        <%= link_to "Propose a New Rule", new_household_rule_path(@household), class: "dashboard-button" %>
        <% if @household.admin?(current_user) %>
          <button type="button" class="dashboard-button dashboard-button-secondary" onclick="document.getElementById('vault-edit-dialog').showModal()">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px; margin-right: 4px;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Edit Vault &amp; Info
          </button>
        <% end %>
        <%= link_to "Members & Access", "#household-people", class: "dashboard-button dashboard-button-secondary" %>
      </div>
    </div>

    <!-- ====================================================================
         SECTION 1: TOP 2-COLUMN GRID (VAULT & ACTIVE POLLS)
         ==================================================================== -->
    <div class="vault-grid">
      <!-- CARD 1: HOUSEHOLD INFO & VAULT -->
      <section class="vault-card" aria-labelledby="vault-heading">
        <div>
          <div class="vault-card-header">
            <div class="vault-card-title-wrap">
              <span class="vault-card-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
              </span>
              <h2 id="vault-heading">Household Info &amp; Vault</h2>
            </div>
            <span class="vault-badge-secure">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Shared Vault
            </span>
          </div>

          <div class="vault-info-rows">
            <!-- WI-FI DETAILS -->
            <div class="vault-info-item">
              <span class="vault-info-label">Wi-Fi Network (SSID) &amp; Password</span>
              <div class="vault-info-value-row">
                <div>
                  <% if @household.wifi_ssid.present? %>
                    <span class="vault-info-text"><%= @household.wifi_ssid %></span>
                  <% else %>
                    <span class="vault-info-text" style="color: #63756e; font-style: italic;">Not set</span>
                  <% end %>
                  <% if @household.wifi_password.present? %>
                    <span style="color: #63756e; margin: 0 0.4rem;">·</span>
                    <span class="vault-info-text" id="vault-wifi-password-display">••••••••</span>
                    <span id="vault-wifi-password-raw" style="display: none;"><%= @household.wifi_password %></span>
                  <% end %>
                </div>
                <% if @household.wifi_password.present? %>
                  <div style="display: flex; gap: 0.4rem;">
                    <button type="button" class="vault-action-btn" onclick="togglePasswordVisibility()" title="Show/Hide Password" aria-label="Toggle password visibility">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                      <span id="vault-pwd-toggle-label">Show</span>
                    </button>
                    <button type="button" class="vault-action-btn" onclick="copyToClipboard(document.getElementById('vault-wifi-password-raw').textContent, this)" title="Copy Wi-Fi Password" aria-label="Copy Wi-Fi Password">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                      <span>Copy</span>
                    </button>
                  </div>
                <% end %>
              </div>
            </div>

            <!-- TRASH PICKUP -->
            <div class="vault-info-item">
              <span class="vault-info-label">Trash &amp; Recycling Pickup</span>
              <div class="vault-info-value-row">
                <span class="vault-info-text">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px; margin-right: 4px; color: #52645d;"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  <% if @household.trash_pickup.present? %>
                    <%= @household.trash_pickup %>
                  <% else %>
                    <span style="color: #63756e; font-style: italic;">Not set</span>
                  <% end %>
                </span>
              </div>
            </div>

            <!-- LANDLORD HOTLINE -->
            <div class="vault-info-item">
              <span class="vault-info-label">Landlord / Maintenance Hotline</span>
              <div class="vault-info-value-row">
                <span class="vault-info-text">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px; margin-right: 4px; color: #245a47;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                  <% if @household.landlord_hotline.present? %>
                    <a href="tel:<%= @household.landlord_hotline.gsub(/[^0-9+]/, '') %>" class="vault-phone-link" id="vault-hotline-text">
                      <%= @household.landlord_hotline %>
                    </a>
                  <% else %>
                    <span id="vault-hotline-text" style="color: #63756e; font-style: italic;">Not set</span>
                  <% end %>
                </span>
                <% if @household.landlord_hotline.present? %>
                  <button type="button" class="vault-action-btn" onclick="copyToClipboard(document.getElementById('vault-hotline-text').textContent, this)" title="Copy Hotline" aria-label="Copy Landlord Hotline">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    <span>Copy</span>
                  </button>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <div class="vault-card-footer">
          <% if @household.admin?(current_user) %>
            <span>Admin Control: You have permission to edit vault details</span>
            <button type="button" class="vault-action-btn" onclick="document.getElementById('vault-edit-dialog').showModal()">
              Edit details &rarr;
            </button>
          <% else %>
            <span>Managed by household admins · Contact an admin to update</span>
          <% end %>
        </div>
      </section>

      <!-- CARD 2: HOUSE RULES & ACTIVE POLLS -->
      <section class="vault-card" aria-labelledby="polls-heading">
        <div>
          <div class="vault-card-header">
            <div class="vault-card-title-wrap">
              <span class="vault-card-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
                </svg>
              </span>
              <h2 id="polls-heading">House Rules &amp; Active Polls</h2>
            </div>
            <span class="rules-status-badge <%= @open_proposals.any? ? 'rules-status-voting' : 'rules-status-approved' %>">
              <%= @approved_rules.size %> Approved, <%= @open_proposals.size %> Pending
            </span>
          </div>

          <div class="vault-rule-preview-list">
            <% if @open_proposals.any? %>
              <% top_proposal = @open_proposals.first %>
              <div class="vault-rule-preview-item is-pending">
                <div class="vault-rule-preview-top">
                  <span class="vault-rule-preview-title"><%= top_proposal.title %></span>
                  <span class="rules-status-badge rules-status-voting">Voting Active</span>
                </div>
                <p style="font-size: 0.85rem; color: #52645d; margin: 0;"><%= truncate(top_proposal.description, length: 90) %></p>
                <div class="vault-rule-preview-actions">
                  <span><strong><%= top_proposal.approve_votes_count %> Approved</strong>, <%= top_proposal.reject_votes_count %> Rejected</span>
                  <% if top_proposal.voted_by?(current_user) %>
                    <span style="font-weight: 600; color: #245a47;">Voted: <%= top_proposal.vote_by(current_user).decision.capitalize %></span>
                  <% else %>
                    <div class="vote-actions-group">
                      <%= button_to "Agree", vote_household_rule_path(@household, top_proposal), method: :post, params: { decision: "approve" }, class: "button-vote-approve", style: "padding: 0.25rem 0.65rem; font-size: 0.78rem;" %>
                      <%= button_to "Disagree", vote_household_rule_path(@household, top_proposal), method: :post, params: { decision: "reject" }, class: "button-vote-reject", style: "padding: 0.25rem 0.65rem; font-size: 0.78rem;" %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <% if @approved_rules.any? %>
              <% @approved_rules.first(2).each do |rule| %>
                <div class="vault-rule-preview-item is-enacted">
                  <div class="vault-rule-preview-top">
                    <span class="vault-rule-preview-title"><%= rule.title %></span>
                    <span class="rules-status-badge rules-status-approved">Enacted</span>
                  </div>
                  <p style="font-size: 0.85rem; color: #1c332e; margin: 0;"><%= truncate(rule.description, length: 100) %></p>
                </div>
              <% end %>
            <% else %>
              <p style="color: #63756e; font-size: 0.9rem; margin: 0.5rem 0;">No house rules enacted yet. Propose your first rule below!</p>
            <% end %>
          </div>
        </div>

        <div class="vault-card-footer">
          <span>Democratic majority voting in effect</span>
          <a href="#approved-rules-heading" style="color: #245a47; font-weight: 600; text-decoration: none;">View all rules &amp; proposals &darr;</a>
        </div>
      </section>
    </div>

    <!-- ====================================================================
         SECTION 2: PROPERTY & LOCATION DETAILS (REPLACING CALENDAR)
         ==================================================================== -->
    <section class="vault-property-section" aria-labelledby="property-heading">
      <div class="vault-card-header" style="margin-bottom: 0;">
        <div class="vault-card-title-wrap">
          <span class="vault-card-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </span>
          <h2 id="property-heading">Property &amp; Location Details</h2>
        </div>
        <% if @household.admin?(current_user) %>
          <button type="button" class="vault-action-btn" onclick="document.getElementById('vault-edit-dialog').showModal()">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Edit Address &amp; Map
          </button>
        <% end %>
      </div>

      <div class="vault-property-grid">
        <!-- LEFT: HOUSE DETAILS & MAILING ADDRESS -->
        <div class="vault-address-card">
          <div>
            <span class="vault-info-label">Apartment / Residence Name</span>
            <h3 style="font-size: 1.15rem; font-weight: 700; color: inherit; margin: 0.3rem 0 1rem;">
              <%= @household.apartment_name.presence || @household.name %>
            </h3>

            <span class="vault-info-label">Official Mailing Address</span>
            <div class="vault-address-wrapper" style="margin-top: 0.35rem; padding: 0.75rem; border: 1px solid var(--theme-border, #d5ded6); border-radius: 0.5rem; background: var(--theme-surface-subtle, #f8faf7);">
              <% if @household.mailing_address.present? %>
                <pre class="vault-address-block" id="vault-address-text"><%= @household.mailing_address %></pre>
              <% else %>
                <span class="vault-address-block" id="vault-address-text" style="color: #63756e; font-style: italic; font-weight: normal; margin: 0;">Not set</span>
              <% end %>
            </div>
          </div>

          <div style="display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap;">
            <% if @household.mailing_address.present? %>
              <button type="button" class="dashboard-button dashboard-button-secondary" onclick="copyToClipboard(document.getElementById('vault-address-text').textContent, this)">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px; margin-right: 4px;"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>Copy Mailing Address</span>
              </button>
            <% end %>
            <span style="font-size: 0.8rem; color: #63756e;">Use for packages &amp; mail delivery</span>
          </div>
        </div>

        <!-- RIGHT: MAP PREVIEW & LINKS -->
        <div class="vault-map-container">
          <div class="vault-map-embed-wrapper">
            <%
              address_query = @household.mailing_address.presence || "#{@household.apartment_name.presence || @household.name}, College Station, TX"
              clean_query = address_query.gsub("\n", ", ")
              encoded_query = ERB::Util.url_encode(clean_query)
              embed_map_src = "https://maps.google.com/maps?q=#{encoded_query}&t=&z=15&ie=UTF8&iwloc=&output=embed"
              safe_map_link = (@household.map_link.presence&.match?(%r{\Ahttps?://}i) ? @household.map_link : nil)
              google_url = safe_map_link || "https://www.google.com/maps/search/?api=1&query=#{encoded_query}"
              apple_url = "https://maps.apple.com/?q=#{encoded_query}"
            %>
            <iframe
              class="vault-map-iframe"
              title="<%= @household.name %> Map Location"
              src="<%= embed_map_src %>"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen>
            </iframe>

            <div class="vault-map-badge">
              <span class="vault-map-badge-dot"></span>
              <span><%= @household.apartment_name.presence || @household.name %></span>
            </div>
          </div>

          <div class="vault-map-footer-bar">
            <span class="vault-map-address-caption" title="<%= @household.mailing_address.present? ? clean_query : 'Address not set' %>">
              <%= @household.mailing_address.present? ? clean_query : "Address not set" %>
            </span>
            <div class="vault-map-links-bar">
              <a href="<%= google_url %>" target="_blank" rel="noopener noreferrer" class="vault-map-btn" title="Open in Google Maps">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                Google Maps &nearr;
              </a>
              <a href="<%= apple_url %>" target="_blank" rel="noopener noreferrer" class="vault-map-btn" title="Open in Apple Maps">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                Apple Maps &nearr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <%= render "households/management" %>

    <!-- ====================================================================
         SECTION 3: APPROVED HOUSE RULES (FULL REPOSITORY)
         ==================================================================== -->
    <div class="dashboard-section-heading">
      <h2 id="approved-rules-heading">Approved House Rules</h2>
      <p><%= pluralize(@approved_rules.size, "active agreement") %></p>
    </div>

    <% if @approved_rules.any? %>
      <div class="dashboard-grid" style="margin-bottom: 2.5rem;">
        <% @approved_rules.each do |rule| %>
          <section class="dashboard-card" id="rule-<%= rule.id %>">
            <div class="dashboard-card-top">
              <span class="rules-category-tag"><%= rule.category %></span>
              <span class="rules-status-badge rules-status-approved">Approved</span>
            </div>

            <h2><%= link_to rule.title, household_rule_path(@household, rule) %></h2>
            <div class="rule-card-description">
              <%= rule.description %>
            </div>

            <div class="dashboard-card-footnote">
              <p style="margin-bottom: 0.5rem; color: var(--dashboard-muted); font-size: 0.8rem;">
                Established <%= rule.approved_at ? rule.approved_at.strftime("%B %d, %Y") : rule.created_at.strftime("%B %d, %Y") %>
                <% if rule.rule_revisions.count > 1 %>
                  · Revision <%= rule.rule_revisions.maximum(:version) %>
                <% end %>
              </p>
              <div>
                <%= link_to "Propose Amendment", amend_household_rule_path(@household, rule) %> ·
                <%= link_to "Version History", history_household_rule_path(@household, rule) %>
              </div>
            </div>
          </section>
        <% end %>
      </div>
    <% else %>
      <div class="dashboard-card dashboard-empty" style="margin-bottom: 2.5rem;">
        <h2>No approved rules yet</h2>
        <p>Propose a rule below to establish household agreements!</p>
      </div>
    <% end %>

    <!-- ====================================================================
         SECTION 4: ACTIVE PROPOSALS & VOTING
         ==================================================================== -->
    <div class="dashboard-section-heading">
      <h2 id="proposals-heading">Active Proposals &amp; Voting</h2>
      <p><%= pluralize(@open_proposals.size, "proposal") %> open for voting</p>
    </div>

    <% if @open_proposals.any? %>
      <div class="dashboard-grid" style="margin-bottom: 2.5rem;">
        <% @open_proposals.each do |proposal| %>
          <section class="dashboard-card" id="proposal-<%= proposal.id %>">
            <div class="dashboard-card-top">
              <span class="rules-category-tag"><%= proposal.category %></span>
              <span class="rules-status-badge rules-status-voting">Vote in progress</span>
            </div>

            <h2><%= proposal.title %></h2>
            <p style="font-size: 0.82rem; color: var(--dashboard-muted); margin-bottom: 0.75rem;">
              <span style="display: inline-flex; align-items: center; gap: 0.35rem; vertical-align: middle;">
                Proposed by <%= user_avatar_tag(proposal.created_by, size: :sm) %> <strong><%= proposal.created_by.name %></strong>
              </span> on <%= proposal.created_at.strftime("%B %d, %Y") %>
              <% if proposal.parent_rule %>
                (Amendment to <%= link_to proposal.parent_rule.title, household_rule_path(@household, proposal.parent_rule) %>)
              <% end %>
            </p>

            <div class="rule-card-description">
              <p><strong>Proposed Agreement:</strong> <%= proposal.description %></p>
              <% if proposal.amendment_reason.present? %>
                <p style="margin-top: 0.4rem;"><strong>Rationale / Reason:</strong> <%= proposal.amendment_reason %></p>
              <% end %>
            </div>

            <div class="rule-vote-panel">
              <div style="font-size: 0.85rem;">
                <strong>Current Votes:</strong>
                <span><%= proposal.approve_votes_count %> Approve · <%= proposal.reject_votes_count %> Reject</span>
                <div style="font-size: 0.78rem; color: var(--dashboard-muted);">
                  (Need <%= proposal.majority_threshold %> of <%= proposal.total_eligible_voters %> votes to pass)
                </div>
              </div>

              <div>
                <% if proposal.voted_by?(current_user) %>
                  <% user_vote = proposal.vote_by(current_user) %>
                  <span style="font-size: 0.85rem; font-weight: 600; color: #245a47;">
                    You voted: <strong><%= user_vote.decision.capitalize %></strong>
                  </span>
                <% else %>
                  <div class="vote-actions-group">
                    <%= button_to "Approve",
                                  vote_household_rule_path(@household, proposal),
                                  method: :post,
                                  params: { decision: "approve" },
                                  class: "button-vote-approve",
                                  form: { style: "display:inline" } %>
                    <%= button_to "Reject",
                                  vote_household_rule_path(@household, proposal),
                                  method: :post,
                                  params: { decision: "reject" },
                                  class: "button-vote-reject",
                                  form: { style: "display:inline" } %>
                  </div>
                <% end %>
              </div>
            </div>
          </section>
        <% end %>
      </div>
    <% else %>
      <div class="dashboard-card" style="margin-bottom: 2.5rem; background: #fff;">
        <p style="color: var(--dashboard-muted);">No active rule proposals currently open for voting.</p>
      </div>
    <% end %>

    <!-- ====================================================================
         SECTION 5: PAST PROPOSALS
         ==================================================================== -->
    <% if @past_proposals.any? %>
      <div class="dashboard-section-heading">
        <h2 id="past-proposals-heading">Past Proposals</h2>
        <p>Decided or archived proposals</p>
      </div>

      <div class="dashboard-grid" style="margin-bottom: 2.5rem;">
        <% @past_proposals.each do |past| %>
          <section class="dashboard-card" id="past-proposal-<%= past.id %>" style="opacity: 0.85;">
            <div class="dashboard-card-top">
              <span class="rules-category-tag"><%= past.category %></span>
              <span class="rules-status-badge <%= past.status == 'approved' ? 'rules-status-approved' : 'rules-status-rejected' %>">
                <%= past.status.capitalize %>
              </span>
            </div>

            <h2><%= past.title %></h2>
            <p style="font-size: 0.85rem; color: var(--dashboard-muted);">
              Proposed by <%= past.created_by.name %> · Concluded with <%= past.approve_votes_count %> Approve / <%= past.reject_votes_count %> Reject
            </p>
            <div class="rule-card-description">
              <%= past.description %>
            </div>
          </section>
        <% end %>
      </div>
    <% end %>

    <!-- ====================================================================
         ADMIN VAULT & PROPERTY EDIT DIALOG (MODAL)
         ==================================================================== -->
    <% if @household.admin?(current_user) %>
      <dialog id="vault-edit-dialog" class="vault-dialog">
        <div class="vault-dialog-content">
          <div class="vault-dialog-header">
            <h3>Edit Household Info &amp; Vault</h3>
            <button type="button" class="vault-dialog-close" onclick="document.getElementById('vault-edit-dialog').close()" aria-label="Close dialog">&times;</button>
          </div>

          <%= form_with model: @household, url: vault_household_rules_path(@household), method: :patch, local: true, class: "dashboard-form" do |f| %>
            <div class="dashboard-form-field">
              <%= f.label :apartment_name, "Apartment / Complex Name" %>
              <%= f.text_field :apartment_name, placeholder: "e.g. Sunset Palms Apt 4B", value: @household.apartment_name %>
            </div>

            <div class="dashboard-form-field">
              <%= f.label :wifi_ssid, "Wi-Fi Network Name (SSID)" %>
              <%= f.text_field :wifi_ssid, placeholder: "e.g. SunsetPalms_5G", value: @household.wifi_ssid %>
            </div>

            <div class="dashboard-form-field">
              <%= f.label :wifi_password, "Wi-Fi Password" %>
              <%= f.text_field :wifi_password, placeholder: "e.g. SuperSecretPassword123", value: @household.wifi_password %>
            </div>

            <div class="dashboard-form-field">
              <%= f.label :trash_pickup, "Trash & Recycling Pickup Schedule" %>
              <%= f.text_field :trash_pickup, placeholder: "e.g. Every Thursday 7:00 AM", value: @household.trash_pickup %>
            </div>

            <div class="dashboard-form-field">
              <%= f.label :landlord_hotline, "Landlord / Maintenance Hotline" %>
              <%= f.text_field :landlord_hotline, placeholder: "e.g. (979) 555-0142", value: @household.landlord_hotline %>
            </div>

            <div class="dashboard-form-field">
              <%= f.label :mailing_address, "Full Mailing Address" %>
              <%= f.text_area :mailing_address, rows: 3, placeholder: "1124 Texas Ave S\nApt 4B\nCollege Station, TX 77840", value: @household.mailing_address %>
            </div>

            <div class="dashboard-form-field">
              <%= f.label :map_link, "Google / Apple Maps Link (Optional)" %>
              <%= f.text_field :map_link, placeholder: "https://maps.google.com/?q=...", value: @household.map_link %>
              <span class="dashboard-form-hint">Leave blank to use the automatic map search with your mailing address.</span>
            </div>

            <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem;">
              <button type="button" class="dashboard-button dashboard-button-secondary" onclick="document.getElementById('vault-edit-dialog').close()">Cancel</button>
              <%= f.submit "Save Vault Details", class: "dashboard-button" %>
            </div>
          <% end %>
        </div>
      </dialog>
    <% end %>

    <footer class="dashboard-footer">Roommate OS <span aria-hidden="true">/</span> A shared space for your household</footer>
  </main>
</div>

<!-- CLIENT JAVASCRIPT FOR VAULT INTERACTIONS -->
<script>
  function togglePasswordVisibility() {
    const display = document.getElementById("vault-wifi-password-display");
    const raw = document.getElementById("vault-wifi-password-raw");
    const label = document.getElementById("vault-pwd-toggle-label");
    if (!display || !raw || !label) return;

    if (display.textContent === "••••••••") {
      display.textContent = raw.textContent;
      label.textContent = "Hide";
    } else {
      display.textContent = "••••••••";
      label.textContent = "Show";
    }
  }

  function copyToClipboard(text, btn) {
    if (!text) return;
    navigator.clipboard.writeText(text.trim()).then(() => {
      const originalText = btn.innerHTML;
      btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> <span>Copied!</span>`;
      btn.style.color = "#245a47";
      setTimeout(() => {
        btn.innerHTML = originalText;
        btn.style.color = "";
      }, 2000);
    }).catch(err => {
      console.error("Could not copy text: ", err);
    });
  }
</script>
